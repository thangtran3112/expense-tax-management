{
  "$defs": {
    "AllCondition": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "all"
      ],
      "type": "object"
    },
    "AnyCondition": {
      "additionalProperties": false,
      "properties": {
        "any": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "any"
      ],
      "type": "object"
    },
    "CompareCondition": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "$ref": "#/$defs/Operand"
        },
        "op": {
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "crosses_above",
            "crosses_below"
          ],
          "type": "string"
        },
        "right": {
          "$ref": "#/$defs/Operand"
        }
      },
      "required": [
        "op",
        "left",
        "right"
      ],
      "type": "object"
    },
    "Condition": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompareCondition"
        },
        {
          "$ref": "#/$defs/WithinPctCondition"
        },
        {
          "$ref": "#/$defs/TimeBetweenCondition"
        },
        {
          "$ref": "#/$defs/AllCondition"
        },
        {
          "$ref": "#/$defs/AnyCondition"
        },
        {
          "$ref": "#/$defs/NotCondition"
        }
      ]
    },
    "LevelOperand": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "level": {
              "enum": [
                "prior_day_high",
                "prior_day_low",
                "prior_day_close",
                "premarket_high",
                "premarket_low",
                "overnight_high",
                "overnight_low"
              ],
              "type": "string"
            }
          },
          "required": [
            "level"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "level": {
              "enum": [
                "opening_range_high",
                "opening_range_low"
              ],
              "type": "string"
            },
            "minutes": {
              "maximum": 120,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "level",
            "minutes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "days": {
              "maximum": 260,
              "minimum": 2,
              "type": "integer"
            },
            "level": {
              "enum": [
                "n_day_high",
                "n_day_low"
              ],
              "type": "string"
            }
          },
          "required": [
            "level",
            "days"
          ],
          "type": "object"
        }
      ]
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "cooldownMinutes": {
          "maximum": 1440,
          "minimum": 0,
          "type": "integer"
        },
        "flatBy": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        },
        "maxOpenPositions": {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        "maxPositionUsd": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "type": "number"
        },
        "maxTradesPerDay": {
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        "pauseAfterDailyLossUsd": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "type": "number"
        }
      },
      "type": "object"
    },
    "NotCondition": {
      "additionalProperties": false,
      "properties": {
        "not": {
          "$ref": "#/$defs/Condition"
        }
      },
      "required": [
        "not"
      ],
      "type": "object"
    },
    "Operand": {
      "anyOf": [
        {
          "$ref": "#/$defs/SeriesOperand"
        },
        {
          "$ref": "#/$defs/LevelOperand"
        },
        {
          "$ref": "#/$defs/ValueOperand"
        }
      ]
    },
    "PaperOrder": {
      "additionalProperties": false,
      "properties": {
        "side": {
          "enum": [
            "buy",
            "sell"
          ],
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "riskUsd": {
                  "exclusiveMinimum": 0,
                  "maximum": 100000,
                  "type": "number"
                }
              },
              "required": [
                "riskUsd"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "shares": {
                  "maximum": 100000,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "shares"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "pctOfBook": {
                  "exclusiveMinimum": 0,
                  "maximum": 100,
                  "type": "number"
                }
              },
              "required": [
                "pctOfBook"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "contracts": {
                  "maximum": 100,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "contracts"
              ],
              "type": "object"
            }
          ]
        },
        "stop": {
          "anyOf": [
            {
              "$ref": "#/$defs/LevelOperand"
            },
            {
              "additionalProperties": false,
              "properties": {
                "atrMultiple": {
                  "exclusiveMinimum": 0,
                  "maximum": 20,
                  "type": "number"
                }
              },
              "required": [
                "atrMultiple"
              ],
              "type": "object"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "r": {
                  "exclusiveMinimum": 0,
                  "maximum": 20,
                  "type": "number"
                }
              },
              "required": [
                "r"
              ],
              "type": "object"
            },
            {
              "$ref": "#/$defs/LevelOperand"
            }
          ]
        }
      },
      "required": [
        "side",
        "size",
        "stop",
        "target"
      ],
      "type": "object"
    },
    "SeriesOperand": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "series": {
              "enum": [
                "open",
                "high",
                "low",
                "close",
                "volume",
                "vwap",
                "gap_pct"
              ],
              "type": "string"
            }
          },
          "required": [
            "series"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "length": {
              "maximum": 500,
              "minimum": 2,
              "type": "integer"
            },
            "series": {
              "enum": [
                "sma",
                "ema",
                "rsi",
                "atr"
              ],
              "type": "string"
            }
          },
          "required": [
            "series",
            "length"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "lookbackDays": {
              "maximum": 60,
              "minimum": 1,
              "type": "integer"
            },
            "series": {
              "const": "rvol",
              "type": "string"
            }
          },
          "required": [
            "series",
            "lookbackDays"
          ],
          "type": "object"
        }
      ]
    },
    "TimeBetweenCondition": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        },
        "op": {
          "const": "time_between",
          "type": "string"
        },
        "start": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        }
      },
      "required": [
        "op",
        "start",
        "end"
      ],
      "type": "object"
    },
    "ValueOperand": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "WithinPctCondition": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "$ref": "#/$defs/Operand"
        },
        "op": {
          "const": "within_pct",
          "type": "string"
        },
        "pct": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "type": "number"
        },
        "right": {
          "$ref": "#/$defs/Operand"
        }
      },
      "required": [
        "op",
        "left",
        "right",
        "pct"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "name": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "then": {
      "additionalProperties": false,
      "properties": {
        "alert": {
          "additionalProperties": false,
          "properties": {
            "channels": {
              "items": {
                "enum": [
                  "inbox",
                  "telegram",
                  "slack"
                ],
                "type": "string"
              },
              "maxItems": 3,
              "minItems": 1,
              "type": "array"
            },
            "severity": {
              "enum": [
                "info",
                "opportunity",
                "risk"
              ],
              "type": "string"
            }
          },
          "required": [
            "channels"
          ],
          "type": "object"
        },
        "paperOrder": {
          "$ref": "#/$defs/PaperOrder"
        }
      },
      "required": [
        "alert"
      ],
      "type": "object"
    },
    "watch": {
      "additionalProperties": false,
      "properties": {
        "runOn": {
          "enum": [
            "bar_close_1m",
            "premarket_0830",
            "daily_close",
            "weekly"
          ],
          "type": "string"
        },
        "session": {
          "enum": [
            "regular",
            "extended"
          ],
          "type": "string"
        },
        "universe": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "watchlist": {
                  "maxLength": 80,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "watchlist"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "symbols": {
                  "items": {
                    "pattern": "^\\/?[A-Z][A-Z0-9.]{0,9}$",
                    "type": "string"
                  },
                  "maxItems": 70,
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": [
                "symbols"
              ],
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "universe",
        "session",
        "runOn"
      ],
      "type": "object"
    },
    "when": {
      "$ref": "#/$defs/Condition"
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "watch",
    "when",
    "then"
  ],
  "type": "object"
}
