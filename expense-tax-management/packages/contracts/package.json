{
  "name": "@expense-tax/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./generated/typescript/app-api.paths": {
      "types": "./dist/generated/typescript/app-api.paths.d.ts",
      "import": "./dist/generated/typescript/app-api.paths.js"
    },
    "./generated/typescript/foundry-service.paths": {
      "types": "./dist/generated/typescript/foundry-service.paths.d.ts",
      "import": "./dist/generated/typescript/foundry-service.paths.js"
    }
  },
  "files": [
    "dist/src",
    "dist/generated"
  ],
  "scripts": {
    "test": "vitest run --dir test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "generate:json-schema": "tsx scripts/generate-json-schema.ts",
    "generate:typescript-clients": "tsx scripts/generate-typescript-clients.ts",
    "check-generated": "node scripts/check-generated.mjs"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
