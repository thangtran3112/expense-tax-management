{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "family-app backup manifest",
  "description": "Written to manifest.json inside the plaintext archive before encryption. backup.sh hand-validates the invariants below (required keys, types, enums) against this document rather than depending on an undeclared transitive ajv install -- see infrastructure/backup/README.md Rulings.",
  "type": "object",
  "required": [
    "backup_host_id",
    "run_id",
    "cutoff",
    "mode",
    "parent_full_backup_id",
    "postgresql_version",
    "databases",
    "files",
    "receipts",
    "deployed_image_tags",
    "schema_migration_versions",
    "compose_checksum"
  ],
  "properties": {
    "backup_host_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "cutoff": { "type": "string", "format": "date-time" },
    "mode": { "type": "string", "enum": ["full", "daily"] },
    "parent_full_backup_id": { "type": "string", "minLength": 1 },
    "postgresql_version": { "type": "string", "minLength": 1 },
    "databases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files": {
      "type": "array",
      "description": "globals.sql plus one entry per database dump",
      "items": {
        "type": "object",
        "required": ["name", "bytes", "sha256"],
        "properties": {
          "name": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "receipts": {
      "type": "object",
      "required": ["archive_name", "file_count", "bytes", "sha256", "files"],
      "properties": {
        "archive_name": { "type": "string" },
        "file_count": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "checksum of the receipts.tar archive itself" },
        "files": {
          "type": "array",
          "description": "one entry per receipt file included in this run's archive, for per-file restore verification",
          "items": {
            "type": "object",
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "deployed_image_tags": { "type": "object" },
    "schema_migration_versions": { "type": "object" },
    "compose_checksum": { "type": ["string", "null"] }
  }
}
